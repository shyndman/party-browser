{
  "name": "@partybrowser/hub",
  "version": "0.1.0",
  "description": "PartyBrowser hub runtime for session authority and routing",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "service:install": "node ../../scripts/install-hub-service.mjs",
    "service:uninstall": "node ../../scripts/uninstall-hub-service.mjs",
    "service:status": "systemctl --user status partybrowser-hub.service --no-pager",
    "service:logs": "journalctl --user -u partybrowser-hub.service -f --no-pager"
  },
  "dependencies": {
    "winston": "^3.19.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2"
  }
}
