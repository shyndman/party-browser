{
  "name": "@partybrowser/extension",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "xpi": "wxt zip -b firefox && node ./scripts/zip-to-xpi.mjs",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "clean": "rm -rf .output .wxt",
    "test": "tsx --test \"src/**/*.test.ts\" \"entrypoints/**/*.test.ts\"",
    "test:e2e": "echo 'E2E tests not yet implemented - Phase 9' && exit 0"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.4",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2",
    "wxt": "^0.20.15"
  }
}
