{
  "name": "@blindflight/mcp",
  "version": "0.1.3",
  "description": "MCP server for browser automation using Blindflight",
  "author": "Blindflight",
  "homepage": "https://blindflight.io",
  "bugs": "https://github.com/blindflight/mcp/issues",
  "type": "module",
  "bin": {
    "blindflight-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && shx chmod +x dist/index.js",
    "watch": "tsup src/index.ts --format esm --watch",
    "clean": "rm -rf dist",
    "test": "echo 'Tests not yet implemented - Phase 9' \u0026\u0026 exit 0",
    "test:watch": "echo 'Tests not yet implemented - Phase 9' \u0026\u0026 exit 0",
    "dev": "mcp web node dist/index.js --port 6277",
    "dev:shell": "mcp shell node dist/index.js",
    "tools": "mcp tools node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^13.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "shx": "^0.3.4",
    "tsup": "^8.4.0",
    "typescript": "^5.6.2"
  }
}
