{
  "name": "@partybrowser/mcp",
  "version": "0.1.3",
  "description": "MCP server for browser automation using PartyBrowser",
  "author": "Scott Hyndman",
  "bugs": "https://github.com/shyndman/partybrowser",
  "type": "module",
  "bin": {
    "partybrowser-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && shx chmod +x dist/index.js",
    "watch": "tsup src/index.ts --format esm --watch",
    "clean": "rm -rf dist",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:watch": "tsx --test --watch \"src/**/*.test.ts\"",
    "dev": "mcp web node dist/index.js --port 6277",
    "dev:shell": "mcp shell node dist/index.js",
    "tools": "mcp tools node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^13.1.0",
    "ws": "^8.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "shx": "^0.3.4",
    "tsup": "^8.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2"
  }
}
