{
  "name": "@partybrowser/root",
  "version": "0.1.3",
  "description": "PartyBrowser - Browser automation for AI agents (workspace root)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "scripts": {
    "install:all": "pnpm install",
    "postinstall": "pnpm run -r postinstall",
    "build": "pnpm run -r build",
    "build:mcp": "pnpm --filter ./packages/mcp build",
    "build:hub": "pnpm --filter ./packages/hub build",
    "build:extension": "pnpm --filter ./packages/extension build",
    "build:extension:xpi": "pnpm --filter ./packages/extension xpi",
    "test": "pnpm run -r test",
    "test:mcp": "pnpm --filter ./packages/mcp test",
    "test:hub": "pnpm --filter ./packages/hub test",
    "test:extension": "pnpm --filter ./packages/extension test",
    "typecheck": "pnpm run -r typecheck",
    "typecheck:mcp": "pnpm --filter ./packages/mcp typecheck",
    "typecheck:hub": "pnpm --filter ./packages/hub typecheck",
    "typecheck:extension": "pnpm --filter ./packages/extension typecheck",
    "lint": "echo 'Linting not configured yet' && exit 0",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "dev": "node scripts/dev-orchestrator.mjs",
    "dev:mcp": "pnpm --filter ./packages/mcp dev",
    "dev:hub": "pnpm --filter ./packages/hub dev",
    "dev:extension": "pnpm --filter ./packages/extension dev",
    "service:install": "pnpm --filter ./packages/hub run service:install",
    "service:uninstall": "pnpm --filter ./packages/hub run service:uninstall",
    "service:status": "pnpm --filter ./packages/hub run service:status",
    "service:logs": "pnpm --filter ./packages/hub run service:logs",
    "service:redeploy": "pnpm run build:hub && systemctl --user restart partybrowser-hub.service && pnpm run service:status"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
