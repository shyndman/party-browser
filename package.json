{
  "name": "@blindflight/root",
  "version": "0.1.3",
  "description": "Blindflight - Browser automation for AI agents (workspace root)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "install:all": "pnpm install",
    "postinstall": "pnpm run -r postinstall",
    "build": "pnpm run -r build",
    "build:mcp": "pnpm --filter ./packages/mcp build",
    "build:extension": "pnpm --filter ./packages/extension build"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
